# Local build-speed tuning (mold + sccache). Copy to .cargo/config.toml, which
# is gitignored on purpose: mold isn't installed for the aarch64 cross-toolchain
# in CI, so a tracked copy broke the release job's aarch64 leg. Without the
# copy, Cargo uses the default linker and no sccache wrapper, which is slower
# but correct. Requires clang, mold and sccache (and aarch64-linux-gnu-gcc for
# the aarch64 target).
[target.x86_64-unknown-linux-gnu]
linker = "clang"
rustflags = ["-C", "link-arg=-fuse-ld=mold"]

[build]
rustc-wrapper = "sccache"

[target.aarch64-unknown-linux-gnu]
linker = "aarch64-linux-gnu-gcc"
ar = "aarch64-linux-gnu-ar"
rustflags = ["-C", "link-arg=-fuse-ld=mold"]
